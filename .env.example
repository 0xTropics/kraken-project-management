# Kraken configuration.
#
# Copy to .env.local and fill in. Two switches decide how much of Supabase is
# in play; the database, API, invoicing engine, and portal are identical in
# both modes. Only identity and file storage move.
#
# A deployment uses supabase for both. local is the development and test
# harness: it needs only a Postgres on localhost.

# ---------------------------------------------------------------- database --
# Local dev: `npm run db:start` prints this exact URL.
# Supabase: Connect -> Session pooler (port 5432). Not the transaction pooler
# (port 6543): postgres.js pipelines the concurrent queries a page fires, and
# transaction mode misroutes their results between queries.
DATABASE_URL=postgres://postgres@127.0.0.1:54329/postgres
# Connections in the pool, per server instance. On Vercel every instance holds
# its own pool, so instances x this value must stay well under the project's
# pooler Pool Size (Supabase -> Settings -> Database). 2 is plenty for one
# operator.
DATABASE_POOL_MAX=2
# Port for the repo-local cluster in .pgdata/. Default 54329. `npm run db:start`
# reads it from the shell, not from this file (LOCAL_DB_PORT=55432 npm run
# db:start), and DATABASE_URL's port above must match it.
LOCAL_DB_PORT=54329

# ----------------------------------------------------------------- secrets --
# Signs the portal cookie, the local internal session cookie, and signed file
# URLs. Minimum 32 characters. Generate with: openssl rand -base64 48
# Rotating it logs every client out and invalidates outstanding download links.
KRAKEN_SESSION_SECRET=

# ------------------------------------------------------------------- modes --
# local    Kraken verifies an argon2id password against internal_users and
#          signs its own session cookie. No cloud account needed.
# supabase Supabase Auth issues the session; KRAKEN_INTERNAL_USER_IDS is the
#          allow-list of user ids permitted into /app.
KRAKEN_AUTH_MODE=local

# local    Invoice PDFs on disk under .storage/, served through a short-lived
#          HMAC-signed URL.
# supabase Invoice PDFs in a private Supabase Storage bucket, served through a
#          short-lived signed URL.
KRAKEN_STORAGE_MODE=local

# --------------------------------------------------------------------- app --
# Absolute base URL. Used for portal links and signed file URLs.
KRAKEN_APP_URL=http://localhost:3100

# ------------------------------------------------------- storage (local) ----
# Directory for invoice PDFs when KRAKEN_STORAGE_MODE=local. Default .storage
KRAKEN_LOCAL_STORAGE_DIR=.storage

# ---------------------------------------------------------------- supabase --
# Required only when KRAKEN_AUTH_MODE=supabase or KRAKEN_STORAGE_MODE=supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER-ONLY SECRET. Belongs in the Vercel environment and nowhere else.
# Never in a NEXT_PUBLIC_ variable, never on a laptop.
SUPABASE_SERVICE_ROLE_KEY=
# Private bucket for invoice PDFs. Default: invoices
KRAKEN_STORAGE_BUCKET=invoices
# Comma-separated allow-list of Supabase user ids permitted into /app.
# Empty means nobody gets in, which is the safe default for a misconfigured deploy.
KRAKEN_INTERNAL_USER_IDS=

# ----------------------------------------------------- invoice letterhead --
KRAKEN_COMPANY_NAME=Fathom Software
KRAKEN_COMPANY_EMAIL=billing@example.com
KRAKEN_COMPANY_ADDRESS=Port Alder BC

# --------------------------------------------------------- seed (dev only) --
# Overrides the demo operator login created by `npm run db:seed`.
KRAKEN_SEED_EMAIL=operator@example.com
KRAKEN_SEED_PASSWORD=Password

# --------------------------------------------------------- tests (dev only) --
# Admin connection the test harness uses to create/drop per-worker databases.
# Falls back to DATABASE_URL when unset.
TEST_ADMIN_DATABASE_URL=
