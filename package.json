{
  "name": "kraken",
  "version": "1.0.0",
  "description": "Project management, time tracking and invoicing for solo developers, with a client portal.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/0xTropics/kraken-project-management.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13 <25"
  },
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "db:reset": "node scripts/db.mjs nuke && node scripts/db.mjs start && npm run db:migrate && npm run db:seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "node scripts/check-private.mjs && npm run typecheck && npm run lint && npm run test && npm run build",
    "db:start": "node scripts/db.mjs start",
    "db:stop": "node scripts/db.mjs stop",
    "db:psql": "node scripts/db.mjs psql",
    "shots": "node scripts/shots.mjs",
    "check:responsive": "node scripts/dev/measure-overflow.mjs",
    "check:a11y": "node scripts/dev/a11y.mjs",
    "check:preview": "node scripts/dev/check-preview-parity.mjs",
    "check:palette": "node scripts/dev/check-palette.mjs",
    "check:portal": "node scripts/dev/portal-nav-check.mjs"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@react-pdf/renderer": "4.9.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "cmdk": "^1.1.1",
    "jose": "6.2.12",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
